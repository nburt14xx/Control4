    <properties>
      <property>
        <name>Bridge</name>
        <type>LABEL</type>
        <default>Bridge</default>
      </property>
      <property>
        <name>Bridge Address</name>
        <type>STRING</type>
        <default />
        <readonly>false</readonly>
        <tooltip>IP address (or host:port) of the Shield running the Shield Bridge app. Port defaults to 8765.</tooltip>
      </property>
      <property>
        <name>API Key</name>
        <type>STRING</type>
        <default />
        <readonly>false</readonly>
        <tooltip>Only needed if 'Require API key' was switched on in the Shield Bridge app.</tooltip>
      </property>
      <property>
        <name>Shield MAC Address</name>
        <type>STRING</type>
        <default />
        <readonly>false</readonly>
        <tooltip>Used for Wake-on-LAN before launching. Shown in the Shield under Settings &gt; Device Preferences &gt; About &gt; Status.</tooltip>
      </property>
      <property>
        <name>Bridge Status</name>
        <type>STRING</type>
        <default />
        <readonly>true</readonly>
      </property>
      <property>
        <name>Behaviour</name>
        <type>LABEL</type>
        <default>Behaviour</default>
      </property>
      <property>
        <name>Wake on Select</name>
        <type>LIST</type>
        <items>
          <item>On</item>
          <item>Off</item>
        </items>
        <default>On</default>
        <readonly>false</readonly>
        <tooltip>Send Wake-on-LAN and a wake request to the Shield whenever this source is selected or an item is launched.</tooltip>
      </property>
      <property>
        <name>Select Room Source</name>
        <type>LIST</type>
        <items>
          <item>If not already selected</item>
          <item>Always</item>
          <item>Never</item>
        </items>
        <default>If not already selected</default>
        <readonly>false</readonly>
        <tooltip>Whether launching an item also selects Shield Bridge as the room's video source. The default skips the command when the room is already on this source, so displays with an IR power toggle are not cycled.</tooltip>
      </property>
      <property>
        <name>Launch Delay (ms)</name>
        <type>RANGED_INTEGER</type>
        <minimum>0</minimum>
        <maximum>15000</maximum>
        <default>0</default>
        <readonly>false</readonly>
        <tooltip>Wait this long after selecting the room source before telling the Shield to launch, so a TV that is still warming up does not miss the opening.</tooltip>
      </property>
      <property>
        <name>After Launch</name>
        <type>LIST</type>
        <items>
          <item>Go to Now Playing</item>
          <item>Stay on list</item>
        </items>
        <default>Go to Now Playing</default>
        <readonly>false</readonly>
      </property>
      <property>
        <name>Forward Remote Commands</name>
        <type>LIST</type>
        <items>
          <item>To device on Video In</item>
          <item>Off</item>
        </items>
        <default>To device on Video In</default>
        <readonly>false</readonly>
        <tooltip>Transport and navigation buttons pressed while this source is selected are passed to the driver bound to the Video In connection (your existing Shield control driver).</tooltip>
      </property>
      <property>
        <name>Lists</name>
        <type>LABEL</type>
        <default>Lists</default>
      </property>
      <property>
        <name>Rows</name>
        <type>LIST</type>
        <items>
          <item>Continue + Up Next + New</item>
          <item>Continue Watching only</item>
          <item>Everything</item>
        </items>
        <default>Continue + Up Next + New</default>
        <readonly>false</readonly>
      </property>
      <property>
        <name>Max Items</name>
        <type>RANGED_INTEGER</type>
        <minimum>5</minimum>
        <maximum>200</maximum>
        <default>40</default>
        <readonly>false</readonly>
      </property>
      <property>
        <name>Refresh Interval (s)</name>
        <type>RANGED_INTEGER</type>
        <minimum>0</minimum>
        <maximum>3600</maximum>
        <default>60</default>
        <readonly>false</readonly>
        <tooltip>How often the driver refreshes its cached list for programming (keypad buttons). 0 disables background refresh.</tooltip>
      </property>
      <property>
        <name>Driver</name>
        <type>LABEL</type>
        <default>Driver</default>
      </property>
      <property>
        <name>Debug Mode</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>Off</default>
        <readonly>false</readonly>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <default />
        <readonly>true</readonly>
      </property>
    </properties>
